# Razorpay Integration Environment Variables
# Copy this file to .env.local for local Next.js development

# Razorpay Key ID (Public key - safe to expose to client)
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXX
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXX

# Razorpay Key Secret (PRIVATE SERVER SECRET - NEVER expose to client)
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX

# Razorpay Webhook Secret (PRIVATE SERVER SECRET - NEVER expose to client)
RAZORPAY_WEBHOOK_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX
